<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         id="WebApp_ID" version="3.1">

    <display-name>ImplementingAnInterface</display-name>

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <!-- 서블릿 정의 -->
    <servlet>
        <servlet-name>MemberController</servlet-name>
        <servlet-class>controller.MemberController</servlet-class>
    </servlet>

    <!-- 서블릿 매핑: 모든 *.mc 패턴을 MemberController 서블릿에 매핑 -->
    <servlet-mapping>
        <servlet-name>MemberController</servlet-name>
        <url-pattern>*.mc</url-pattern>
    </servlet-mapping>

    <!-- 필터 정의 -->
    <filter>
        <filter-name>CheckCookieFilter</filter-name>
        <filter-class>filters.CheckCookieFilter</filter-class>
        <init-param>
            <param-name>cookieName</param-name>
            <param-value>id</param-value>
        </init-param>
        <init-param>
            <param-name>encoding</param-name>
            <param-value>true</param-value>
        </init-param>
    </filter>

    <!-- 필터 매핑: 모든 URL 패턴에 CheckCookieFilter를 적용 -->
    <filter-mapping>
        <filter-name>CheckCookieFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

</web-app>
